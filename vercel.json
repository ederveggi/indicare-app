{
  "version": 2,
  "functions": {
    "api/claude.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/privacidade.html", "dest": "/privacidade.html" },
    { "src": "/privacidade", "dest": "/privacidade.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
